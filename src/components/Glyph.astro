---
// Ikon sederhana untuk tiap bidang kerja. Warna mengikuti `color` di elemen induk.
interface Props {
  kind: 'laravel' | 'clipper' | 'game2d' | 'game3d';
  class?: string;
}

const { kind, class: className } = Astro.props;

// Pola piksel untuk Game 2D (X = terisi)
const sprite = [
  '.XX.XX.',
  'XXXXXXX',
  'XXXXXXX',
  '.XXXXX.',
  '..XXX..',
  '...X...',
];
const cell = 6;
const ox = (64 - 7 * cell) / 2;
const oy = (64 - sprite.length * cell) / 2;
const pixels: { x: number; y: number }[] = [];
sprite.forEach((row, r) =>
  [...row].forEach((ch, c) => {
    if (ch === 'X') pixels.push({ x: ox + c * cell, y: oy + r * cell });
  })
);
---

<svg
  class={className}
  viewBox="0 0 64 64"
  fill="none"
  stroke="currentColor"
  stroke-width="2.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {
    kind === 'laravel' && (
      <>
        <rect x="8" y="12" width="48" height="40" rx="5" />
        <path d="M8 22h48" />
        <circle cx="14" cy="17" r="1.2" fill="currentColor" stroke="none" />
        <circle cx="19" cy="17" r="1.2" fill="currentColor" stroke="none" />
        <circle cx="24" cy="17" r="1.2" fill="currentColor" stroke="none" />
        <path d="M26 30l-6 7 6 7" />
        <path d="M38 30l6 7-6 7" />
        <path d="M34 29l-4 16" />
      </>
    )
  }
  {
    kind === 'clipper' && (
      <>
        <rect x="6" y="16" width="52" height="32" rx="4" />
        <path d="M12 21h4M22 21h4M32 21h4M42 21h4M52 21h2" stroke-width="3" />
        <path d="M12 43h4M22 43h4M32 43h4M42 43h4M52 43h2" stroke-width="3" />
        <rect x="14" y="27" width="36" height="10" rx="1.5" />
        <path d="M41 6L25 58" stroke-dasharray="4 4" />
      </>
    )
  }
  {
    kind === 'game2d' && (
      <g fill="currentColor" stroke="none">
        {pixels.map((p) => (
          <rect x={p.x} y={p.y} width={cell - 0.8} height={cell - 0.8} rx="0.8" />
        ))}
      </g>
    )
  }
  {
    kind === 'game3d' && (
      <>
        <path d="M32 8l22 12v24L32 56 10 44V20z" />
        <path d="M32 8l22 12-22 12-22-12z" fill="currentColor" fill-opacity="0.35" />
        <path d="M10 20l22 12v24L10 44z" fill="currentColor" fill-opacity="0.18" />
        <path d="M32 32v24" />
      </>
    )
  }
</svg>
