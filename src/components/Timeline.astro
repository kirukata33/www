---
// Motif editor video: empat track, satu playhead.
// Playhead berjalan sekali saat halaman dibuka; pengunjung bisa menggesernya sendiri.
type Clip = { label: string; s: number; w: number };
type Track = { name: string; color: string; clips: Clip[] };

const tracks: Track[] = [
  {
    name: 'Laravel',
    color: 'violet',
    clips: [
      { label: 'Web app', s: 0, w: 34 },
      { label: 'Panel admin', s: 36, w: 30 },
      { label: 'API', s: 68, w: 32 },
    ],
  },
  {
    name: 'Clipper',
    color: 'amber',
    clips: [
      { label: 'Potong', s: 6, w: 22 },
      { label: 'Ritme', s: 30, w: 26 },
      { label: 'Short', s: 58, w: 20 },
      { label: 'Final', s: 80, w: 20 },
    ],
  },
  {
    name: 'Game 2D',
    color: 'teal',
    clips: [
      { label: 'Sprite', s: 0, w: 24 },
      { label: 'Gameplay', s: 26, w: 38 },
      { label: 'UI', s: 66, w: 34 },
    ],
  },
  {
    name: 'Game 3D',
    color: 'rose',
    clips: [
      { label: 'Level', s: 12, w: 30 },
      { label: 'Karakter', s: 44, w: 28 },
      { label: 'Kamera', s: 74, w: 26 },
    ],
  },
];

const ticks = ['00:00', '00:15', '00:30', '00:45', '01:00'];
---

<figure class="tl" id="timeline">
  <div class="readout">
    <p class="timecode" id="tl-time" aria-hidden="true">00:00</p>
    <ul class="chips" id="tl-active" aria-hidden="true"></ul>
  </div>

  <div class="tl-grid">
    <div class="tl-spacer" aria-hidden="true"></div>
    <div class="tl-ruler" aria-hidden="true">
      {
        ticks.map((t, i) => (
          <span
            class:list={['tick', i === ticks.length - 1 && 'last', (i === 1 || i === 3) && 'mid']}
            style={`left:${i * 25}%`}
          >
            {t}
          </span>
        ))
      }
    </div>

    {
      tracks.map((track) => (
        <>
          <div class="tl-label" style={`--c: var(--${track.color})`}>
            <span class="dot" aria-hidden="true" />
            {track.name}
          </div>
          <div class="tl-track" style={`--c: var(--${track.color})`}>
            {track.clips.map((clip) => (
              <span
                class="clip"
                data-s={clip.s}
                data-w={clip.w}
                data-track={track.name}
                data-color={track.color}
                style={`left:${clip.s}%;width:${clip.w}%`}
              >
                {clip.label}
              </span>
            ))}
          </div>
        </>
      ))
    }

    <div class="tl-lane">
      <span class="playhead" id="tl-playhead" aria-hidden="true"></span>
      <input
        id="tl-range"
        type="range"
        min="0"
        max="600"
        step="1"
        value="0"
        aria-label="Geser playhead untuk melihat bidang kerja"
      />
    </div>
  </div>

  <figcaption class="hint">Geser garis kuning untuk melihat apa yang saya kerjakan di tiap detik.</figcaption>
</figure>

<style>
  .tl {
    --label: 5.25rem;
    --gap: 0.75rem;
    margin: 0;
    border: 1px solid var(--line);
    border-radius: 0.9rem;
    background: var(--surface);
    padding: 1.1rem 1.1rem 0.9rem;
  }

  .readout {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.5rem;
    min-height: 3.6rem;
    margin-bottom: 0.9rem;
  }

  .timecode {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 2.6rem;
    line-height: 1;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
    min-width: 5.2ch;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .chips :global(li) {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--c) 55%, transparent);
    background: color-mix(in srgb, var(--c) 14%, transparent);
    font-size: 0.8rem;
    font-weight: 600;
    white-space: nowrap;
  }

  .chips :global(li)::before {
    content: '';
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 999px;
    background: var(--c);
  }

  .tl-grid {
    position: relative;
    display: grid;
    grid-template-columns: var(--label) 1fr;
    column-gap: var(--gap);
    row-gap: 0.5rem;
    align-items: center;
  }

  .tl-ruler {
    position: relative;
    height: 1.25rem;
    border-bottom: 1px solid var(--line);
    font-size: 0.7rem;
    color: var(--muted);
  }

  .tick {
    position: absolute;
    bottom: 2px;
    padding-left: 0.3rem;
    border-left: 1px solid var(--line);
    line-height: 1;
  }

  .tick.last {
    transform: translateX(-100%);
    padding-left: 0;
    padding-right: 0.3rem;
    border-left: 0;
    border-right: 1px solid var(--line);
  }

  .tl-label {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--muted);
    white-space: nowrap;
  }

  .dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 999px;
    background: var(--c);
    flex: none;
  }

  .tl-track {
    position: relative;
    height: 2.25rem;
    border-radius: 0.4rem;
    background: color-mix(in srgb, var(--fg) 4%, transparent);
  }

  .clip {
    position: absolute;
    top: 0;
    bottom: 0;
    display: flex;
    align-items: center;
    padding: 0 0.6rem;
    border-left: 3px solid var(--c);
    border-radius: 0.3rem;
    background: color-mix(in srgb, var(--c) 24%, var(--surface));
    font-size: 0.78rem;
    font-weight: 500;
    color: var(--fg);
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    transition: opacity 0.15s, background-color 0.15s;
  }

  /* Setelah skrip aktif: klip yang sedang dilewati playhead menyala */
  .tl.js .clip {
    opacity: 0.5;
  }
  .tl.js .clip.on {
    opacity: 1;
    background: color-mix(in srgb, var(--c) 48%, var(--surface));
  }

  .tl-lane {
    position: absolute;
    top: -0.35rem;
    bottom: 0;
    left: calc(var(--label) + var(--gap));
    right: 0;
  }

  .tl-lane input {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: ew-resize;
    touch-action: pan-y;
    -webkit-appearance: none;
    appearance: none;
  }
  .tl-lane input::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 0;
    height: 0;
  }
  .tl-lane input::-moz-range-thumb {
    width: 0;
    height: 0;
    border: 0;
  }

  .playhead {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 2px;
    margin-left: -1px;
    background: var(--amber);
    pointer-events: none;
  }

  .playhead::before {
    content: '';
    position: absolute;
    top: 0;
    left: -5px;
    width: 12px;
    height: 12px;
    background: var(--amber);
    clip-path: polygon(0 0, 100% 0, 50% 100%);
  }

  /* fokus keyboard tampil pada garis playhead */
  .tl-lane:has(input:focus-visible) .playhead {
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--amber) 40%, transparent);
  }

  .hint {
    margin-top: 0.8rem;
    font-size: 0.82rem;
    color: var(--muted);
  }

  @media (max-width: 36rem) {
    .tl {
      --label: 4.25rem;
      --gap: 0.5rem;
      padding: 0.9rem 0.8rem 0.8rem;
    }
    .tick.mid {
      display: none;
    }
    .clip {
      padding: 0 0.4rem;
      font-size: 0.7rem;
    }
    .timecode {
      font-size: 2.2rem;
    }
    .readout {
      min-height: 5.6rem;
      align-content: flex-start;
    }
  }
</style>

<script>
  const root = document.getElementById('timeline') as HTMLElement;
  const range = document.getElementById('tl-range') as HTMLInputElement;
  const playhead = document.getElementById('tl-playhead') as HTMLElement;
  const timeEl = document.getElementById('tl-time') as HTMLElement;
  const activeEl = document.getElementById('tl-active') as HTMLElement;

  const DURATION = 60; // detik pada timeline
  const MAX = Number(range.max);

  const clips = [...root.querySelectorAll<HTMLElement>('.clip')].map((el) => {
    const s = Number(el.dataset.s);
    return {
      el,
      s,
      e: s + Number(el.dataset.w),
      track: el.dataset.track ?? '',
      color: el.dataset.color ?? 'violet',
      label: el.textContent?.trim() ?? '',
    };
  });

  const pad = (n: number) => String(n).padStart(2, '0');

  function setPos(pct: number) {
    pct = Math.max(0, Math.min(100, pct));
    playhead.style.left = pct + '%';
    const sec = Math.round((pct / 100) * DURATION);
    const text = `${pad(Math.floor(sec / 60))}:${pad(sec % 60)}`;
    timeEl.textContent = text;

    const active = clips.filter((c) => pct >= c.s && pct <= c.e);
    clips.forEach((c) => c.el.classList.toggle('on', active.includes(c)));

    activeEl.replaceChildren(
      ...active.map((c) => {
        const li = document.createElement('li');
        li.style.setProperty('--c', `var(--${c.color})`);
        li.textContent = `${c.track}: ${c.label}`;
        return li;
      })
    );

    range.value = String(Math.round((pct / 100) * MAX));
    range.setAttribute(
      'aria-valuetext',
      `${text}. ${active.map((c) => `${c.track}: ${c.label}`).join(', ')}`
    );
  }

  root.classList.add('js');

  let raf = 0;
  const stopAuto = () => cancelAnimationFrame(raf);

  range.addEventListener('input', () => {
    stopAuto();
    setPos((Number(range.value) / MAX) * 100);
  });
  range.addEventListener('pointerdown', stopAuto);

  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (reduce) {
    setPos(100);
  } else {
    setPos(0);
    const total = 5200;
    const delay = 500;
    const t0 = performance.now() + delay;
    const ease = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);
    const tick = (now: number) => {
      const t = Math.min(1, Math.max(0, (now - t0) / total));
      setPos(ease(t) * 100);
      if (t < 1) raf = requestAnimationFrame(tick);
    };
    raf = requestAnimationFrame(tick);
  }
</script>
