---
import '@fontsource-variable/bricolage-grotesque';
import '@fontsource-variable/figtree';
import '../styles/global.css';
import { site, nav } from '../data/site';
import ClothPeelIntro from '../components/ClothPeelIntro.astro';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = site.description } = Astro.props;
const fullTitle = title ? `${title} | ${site.name}` : `${site.name} | ${site.role}`;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<!doctype html>
<html lang="id" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <title>{fullTitle}</title>
    <script is:inline>
      // Tema terang jadi bawaan; pilihan pengunjung disimpan di browser.
      (function () {
        try {
          var saved = localStorage.getItem('theme');
          if (saved === 'light' || saved === 'dark') {
            document.documentElement.dataset.theme = saved;
          }
        } catch (e) {}
      })();
    </script>
    <script is:inline>
      // Play the opening once per tab, on the home page only.
      (function () {
        var path = window.location.pathname.replace(/\/+$/, '') || '/';
        if (path !== '/' || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        try {
          if (window.sessionStorage.getItem('portfolio-cloth-intro-seen')) return;
        } catch (e) {}
        document.documentElement.dataset.clothIntro = 'enabled';
      })();
    </script>
  </head>
  <body class="min-h-screen flex flex-col">
    <a
      href="#isi"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:bg-surface focus:px-3 focus:py-2 focus:rounded"
      >Lompat ke isi</a
    >

    <header class="site-header sticky top-0 z-40">
      <div class="wrap header-inner flex flex-wrap items-center justify-between gap-x-6 gap-y-2 py-3">
        <a href="/" class="brand font-display text-lg font-extrabold no-underline" aria-label="Beranda">
          <span class="brand-mark" aria-hidden="true">A</span>
          <span>{site.name}</span>
        </a>
        <div class="flex items-center gap-2">
          <nav aria-label="Navigasi utama">
            <ul class="site-nav flex flex-wrap items-center gap-1 text-sm font-medium">
              {
                nav.map((item) => (
                  <li>
                    <a
                      href={item.href}
                      aria-current={path === item.href ? 'page' : undefined}
                      class:list={[
                        'inline-block rounded-md px-3 py-1.5 no-underline transition-colors',
                        path === item.href
                          ? 'bg-surface text-fg'
                          : 'text-muted hover:text-fg',
                      ]}
                    >
                      {item.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </nav>
          <button
            id="theme-toggle"
            type="button"
            class="theme-toggle grid h-9 w-9 place-items-center rounded-md border border-line text-muted transition-colors hover:text-fg"
            aria-label="Ganti tema terang atau gelap"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <circle cx="12" cy="12" r="9"></circle>
              <path d="M12 3a9 9 0 0 1 0 18z" fill="currentColor"></path>
            </svg>
          </button>
        </div>
      </div>
    </header>

    <main id="isi" class="flex-1">
      <slot />
    </main>

    <footer class="site-footer border-t border-line">
      <div class="wrap flex flex-wrap items-center justify-between gap-3 py-6 text-sm text-muted">
        <p>&copy; {new Date().getFullYear()} {site.name}</p>
        <ul class="flex gap-4">
          {
            site.socials.map((s) => (
              <li>
                <a href={s.href} rel="noopener" class="hover:text-fg">
                  {s.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </footer>

    {path === '/' && <ClothPeelIntro />}

    <script is:inline>
      document.getElementById('theme-toggle').addEventListener('click', function () {
        var next = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
        document.documentElement.dataset.theme = next;
        try {
          localStorage.setItem('theme', next);
        } catch (e) {}
      });
    </script>
  </body>
</html>

<style>
  .site-header {
    border-bottom: 1px solid color-mix(in srgb, var(--line) 78%, transparent);
    background: color-mix(in srgb, var(--bg) 92%, transparent);
    backdrop-filter: blur(14px);
  }

  :global(html.cloth-intro-playing),
  :global(html.cloth-intro-playing body) {
    overflow: hidden;
  }

  .header-inner {
    min-height: 4.75rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    letter-spacing: -0.035em;
  }

  .brand-mark {
    display: grid;
    width: 2rem;
    height: 2rem;
    place-items: center;
    border-radius: 0.25rem;
    background: var(--violet);
    color: white;
    font-size: 1rem;
    box-shadow: 3px 3px 0 var(--fg);
  }

  .site-nav a[aria-current='page'] {
    color: var(--fg);
    background: color-mix(in srgb, var(--amber) 16%, var(--surface));
    box-shadow: inset 0 -2px 0 var(--violet);
  }

  .theme-toggle {
    background: var(--bg);
  }

  .theme-toggle:hover {
    border-color: var(--violet);
    background: var(--surface);
  }

  .site-footer {
    background: var(--fg);
    color: var(--bg);
  }

  .site-footer :global(a:hover) {
    color: var(--amber);
  }

  .site-footer :global(.text-muted) {
    color: color-mix(in srgb, var(--bg) 70%, var(--fg));
  }

  @media (max-width: 38rem) {
    .header-inner {
      padding-block: 0.7rem;
    }
    .site-nav {
      gap: 0;
    }
    .site-nav a {
      padding-inline: 0.55rem;
      font-size: 0.8rem;
    }
  }
</style>
